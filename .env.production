# Production build values. These mirror what the live React build resolves to:
# Vite lets frontend/.env.production override frontend/.env, so uploads go direct to S3
# and SMS OTP is off in production.

NEXT_PUBLIC_API_BASE_URL=https://api.lendigomicrocare.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.lendigomicrocare.com
NEXT_PUBLIC_UPLOAD_VIA_BACKEND=false
# Customer login/register SMS OTP — false until 2Factor production is live
NEXT_PUBLIC_AUTH_SMS_OTP_ENABLED=false
# Must match backend PAYLOAD_ENCRYPTION_KEY. Not committed: the deploy workflow injects it
# from the GitHub secret NEXT_PUBLIC_PAYLOAD_ENCRYPTION_KEY at build time.
# NEXT_PUBLIC_PAYLOAD_ENCRYPTION_KEY=
