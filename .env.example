# Every variable below is inlined into the browser bundle at build time.
# Never put server-only secrets (database credentials, private API keys) in NEXT_PUBLIC_* variables.

# Backend REST API (same value the React app used as VITE_API_BASE_URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# Socket.io server
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Direct browser -> S3 presigned POST uploads. Set true only to force the legacy proxy upload via POST /upload/file
NEXT_PUBLIC_UPLOAD_VIA_BACKEND=false

# Customer login/register mobile OTP. Anything other than "false" enables it.
NEXT_PUBLIC_AUTH_SMS_OTP_ENABLED=true

# Response payload decryption key. Must match the backend PAYLOAD_ENCRYPTION_KEY.
# NOTE: responses are decrypted in the browser, so this key is visible to anyone who loads the app
# (same as the React build). See MIGRATION_NOTES.md.
NEXT_PUBLIC_PAYLOAD_ENCRYPTION_KEY=

# Optional Digitap e-sign overrides (defaults are derived from window.location.origin)
# NEXT_PUBLIC_DIGITAP_ESIGN_REDIRECT_URL=
# NEXT_PUBLIC_DIGITAP_ESIGN_ERROR_URL=
# NEXT_PUBLIC_DIGITAP_ESIGN_SDK_PAGE=https://sdk.digitap.ai/e-sign/templateesignprocess.html
